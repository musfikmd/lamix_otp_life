# Server Configuration
PORT=3000

# Telegram Bot Token (Get from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAEXAMPLE_TELEGRAM_BOT_TOKEN
ADMIN_BOT_TOKEN=123456789:AAEXAMPLE_ADMIN_BOT_TOKEN

# WebApp URL (When deploying on VPS, Render, Ngrok, etc.)
# Note: Telegram Mini Apps REQUIRE HTTPS! E.g. https://your-domain.com
WEBAPP_URL=https://your-domain.com

# Supabase PostgreSQL Database (Optional - App includes in-memory fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Lamix SMS Provider API
LAMIX_API_TOKEN=your_lamix_api_token
LAMIX_BASE_URL=https://lamix.pro/api
USD_TO_BDT_RATE=125

# Live SMS Feed Channel Configuration (Matches Pro SMS FEED style)
FEED_BOT_TOKEN=123456789:AAEXAMPLE_FEED_BOT_TOKEN
FEED_CHANNEL_ID=-1001234567890
FEED_CHANNEL_INVITE_URL=https://t.me/+your_invite_link
FEED_TITLE=Pro SMS FEED
NUMBER_BOT_URL=https://t.me/OTP_LIFE_bot
MAIN_CHANNEL_URL=https://t.me/prosmspanel

