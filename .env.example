# Server Configuration
PORT=3000

# Telegram Bot Token (Get from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAEXAMPLE_TELEGRAM_BOT_TOKEN

# WebApp URL (When deploying on Render, Ngrok, Railway, or VPS)
# Note: Telegram Mini Apps REQUIRE HTTPS! E.g. https://your-domain.com or https://xxxx.ngrok-free.app
WEBAPP_URL=https://your-domain.com

# Supabase PostgreSQL Database (Optional - App includes in-memory fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
